# Central control plane
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-password
SESSION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_URL=https://proxy.example.com
COOKIE_SECURE=true
CONTROL_PORT=8088

# Change this after publishing the image to your registry.
NODE_IMAGE=ghcr.io/neluckoff/proxyfleet:latest
PROXYFLEET_IMAGE=proxyfleet:local

# Node compose (use values generated by the panel)
CONTROL_URL=https://proxy.example.com
ENROLL_TOKEN=
HTTP_PROXY_PORT=3128
SOCKS_PROXY_PORT=1080
